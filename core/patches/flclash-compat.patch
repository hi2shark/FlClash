+package statistic
+
+type RequestNotify func(c Tracker)
+
+var DefaultRequestNotify RequestNotify
+
+func (m *Manager) NowTraffic(onlyProxy bool) (up int64, down int64) {
+	if onlyProxy {
+		return m.proxyUploadBlip.Load(), m.proxyDownloadBlip.Load()
+	}
+
+	return m.Now()
+}
+
+func (m *Manager) TotalTraffic(onlyProxy bool) (up int64, down int64) {
+	if onlyProxy {
+		return m.proxyUploadTotal.Load(), m.proxyDownloadTotal.Load()
+	}
+
+	return m.Total()
+}
